# OncoScan Backend — Environment Configuration
# Copy this file to .env and customize for your deployment.

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to "true" to enable Swagger UI at /docs and ReDoc at /redoc
ENABLE_DOCS=false

# Classification threshold for sigmoid output.
# Values >= threshold → Malignant; < threshold → Benign.
# Must be calibrated against a validation set for clinical credibility.
CLASSIFICATION_THRESHOLD=0.5

# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=10

# Server port
PORT=8000

# Environment: "development" enables auto-reload; "production" disables it
ENV=production
